# Canonical JyotiAI backend origin. Do not point this at a second payment/ticket backend.
JYOTIAI_ADMIN_API_ORIGIN=https://jyotiai.in

# Local-only first SuperAdmin bootstrap. Copy the Firebase Admin values from the
# canonical JyotiAI server environment. Never commit real values.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Recommended production host for this app:
# https://admin.jyotiai.in
